{
  "$schema": "https://github.com/garrytan/gstack/docs/pregate.md#pregate-v1",
  "runner": "/usr/bin/python3 -m unittest {files}",
  "dependencies": {
    "cv4pve_tigervnc_wrapper.py": [
      "test_cv4pve_tigervnc_wrapper.py"
    ],
    "ruff.toml": [
      "test_cv4pve_tigervnc_wrapper.py"
    ],
    ".github/workflows/ci.yml": [
      "test_cv4pve_tigervnc_wrapper.py"
    ]
  },
  "empty_lanes": [],
  "selection": {},
  "warn": [],
  "strays": {
    "allow": [
      "cv4pve_tigervnc_wrapper.py",
      "test_cv4pve_tigervnc_wrapper.py",
      "ruff.toml",
      ".github"
    ]
  },
  "allowlist": [
    {
      "finding": "env.kv",
      "paths": [
        "test_cv4pve_tigervnc_wrapper.py"
      ],
      "reason": "the .vv fixture template's password= placeholder line only (pattern-anchored); a real credential pasted into this file must still fail",
      "pattern": "\\{password\\}"
    }
  ]
}